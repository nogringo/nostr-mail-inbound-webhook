# Required: Nostr private key used by the webhook to sign outgoing Nostr Mail.
# Accepts either nsec1... or a 64-character hex private key.
NOSTR_PRIVATE_KEY=nsec1...

# Optional but recommended: shared secret used to verify Mailgun-style webhook
# signatures from Haraka.
WEBHOOK_SIGNING_KEY=change-me

# Host port exposed by Docker Compose.
PORT=8080

# Reject webhook signatures older/newer than this many seconds.
SIGNATURE_TOLERANCE_SECONDS=900

# Optional comma-separated Nostr bootstrap relays. Leave empty to use defaults.
BOOTSTRAP_NOSTR_RELAYS=

# Optional comma-separated fallback DM relays for nostr_mail.
DEFAULT_DM_RELAYS=

# Optional comma-separated fallback Blossom servers for large MIME payloads.
DEFAULT_BLOSSOM_SERVERS=

# Maximum decoded body-mime size, in bytes.
MAX_MIME_BYTES=67108864
